# Copy this file to ".env" (same folder as manage.py) and adjust it.
# Real environment variables take precedence over this file.

# ---- Django ----------------------------------------------------------------
# Required unless DJANGO_DEBUG=1. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Comma separated host names; "*" accepts any Host header.
DJANGO_ALLOWED_HOSTS=*
# DJANGO_DB_PATH=/path/to/db.sqlite3          # default: db.sqlite3 next to manage.py
# DJANGO_TIME_ZONE=Asia/Shanghai
# DJANGO_COOKIE_SECURE=1                      # default: on unless DEBUG; set 0 for plain http
# DJANGO_BEHIND_HTTPS_PROXY=1                 # the proxy terminates TLS and sends X-Forwarded-Proto
# DJANGO_LOG_LEVEL=INFO

# ---- Site identity (all optional) -------------------------------------------
SITE_NAME=CodeEditor
SITE_TAGLINE=在线代码面试
# SITE_URL=https://example.com
# SITE_COPYRIGHT=© 2026 Example
# SITE_ICP_NUMBER=京ICP备00000000号-1
# SITE_POLICE_NUMBER=京公网安备00000000000000号
# SITE_POLICE_CODE=00000000000000
# SITE_REPO_URL=https://github.com/you/your-fork
# BAIDU_SITE_VERIFICATION=
# BAIDU_UNION_SCRIPT=0
# ACME_CHALLENGE_DIR=/var/www/example/.well-known/acme-challenge

# ---- Rooms -------------------------------------------------------------------
# ROOM_MAX_PEERS=12
# ROOM_MAX_DOC_CHARS=200000
# ROOM_RETENTION_DAYS=30                      # used by "manage.py cleanup_rooms"

# ---- Code execution ------------------------------------------------------------
# Run "python manage.py sandbox_check" to see what is in effect on your host.
# SANDBOX_ROOT=/var/lib/codetool/sandbox      # must allow executing files (no "noexec" mount)
# SANDBOX_MAX_CONCURRENCY=2
# SANDBOX_UID_BASE=61000                      # uids UID_BASE .. UID_BASE+MAX_CONCURRENCY-1 are used when root
# SANDBOX_NETWORK=0                           # 1 = let programs use the network
# SANDBOX_RUN_CPU_SECONDS=5
# SANDBOX_RUN_WALL_SECONDS=10
# SANDBOX_RUN_MEMORY_MB=256
# SANDBOX_OUTPUT_KB=256
# SANDBOX_MAX_PROCESSES=32
# SANDBOX_PYTHON=/usr/local/bin/python3.11    # interpreter for user programs (default: the server's own)
# SANDBOX_GXX=g++
# SANDBOX_GCC=gcc
# SANDBOX_NODE=node
# SANDBOX_CXX_STD=c++11
# SANDBOX_C_STD=gnu99

# ---- Rate limits ("count/seconds") ----------------------------------------------
# RATE_RUN_PER_IP=30/60
# RATE_RUN_PER_ROOM=20/60
# RATE_SUBMIT_PER_USER=10/60
# RATE_AUTH_PER_IP=20/300
# RATE_SIGNUP_PER_IP=10/3600
# TRUST_PROXY_HEADERS=1                       # believe X-Real-IP / X-Forwarded-For from your proxy

# ---- Membership purchases through Alipay (optional) ------------------------------
# Needs "pip install -r requirements-payment.txt" and the collection QR codes at
# editor/static/images/alipay_qir_<amount>.png (e.g. alipay_qir_1.00.png).
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_FILE=configs/app_private_key.txt
# ALIPAY_PUBLIC_KEY_FILE=configs/alipay_public_key.txt
# PAYMENT_ORDER_TTL_SECONDS=600
# SIGNUP_BONUS_DAYS=30
